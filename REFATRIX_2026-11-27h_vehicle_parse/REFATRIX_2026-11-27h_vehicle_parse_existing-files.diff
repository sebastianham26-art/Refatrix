+    const lead = /^[\s,/&+;]*/.exec(rest)[0].length;
+    const n = knownMakerAt(rest.slice(lead));
+    if (!n) break;
+    end = pos + lead + n; pos = end;
+    if (!/^\s*[,/&+;]/.test(modelPart.slice(pos))) break;   // 다음이 구분자일 때만 메이커가 더 이어진다
+  }
+  if (end) {
