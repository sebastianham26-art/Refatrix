# ── 1단계: 웹훅 ─────────────────────────────
# Meta Webhooks 구성의 "인증 토큰"과 똑같이
WA_VERIFY_TOKEN=
# Meta 앱 > 앱 설정 > 기본 > 앱 시크릿 코드
WA_APP_SECRET=

# ── 2단계: 일일 자금 요약 전송 ───────────────
# 시스템 사용자 영구 토큰 (임시 토큰 X)
WA_TOKEN=
# 새로 등록한 번호의 Phone Number ID
WA_PHONE_NUMBER_ID=
ERP_BASE_URL=https://refatrix-production.up.railway.app
# 내부 리포트 페이지 접근용 비밀키 (임의 문자열)
INTERNAL_REPORT_KEY=
# 수신자, 쉼표 구분 (52 + 10자리)
DAILY_REPORT_TO=
